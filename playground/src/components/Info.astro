---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="info" tabindex="0" aria-label={text}>
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.25"
    ></circle>
    <path
      d="M8 7.25v4M8 4.75v.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
  <span class="tip" role="tooltip">{text}</span>
</span>
