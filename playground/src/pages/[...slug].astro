---
import Layout from '../layouts/Layout.astro';
import { copy } from '../lib/copy';
import {
  articles,
  pageHref,
  presetClass,
  presetInfo,
  staticPaths,
  type PageId,
  type PresetId,
} from '../lib/routes';

export function getStaticPaths() {
  return staticPaths();
}

interface Props {
  preset: PresetId;
  page: PageId;
  direction?: string;
}

const { preset, page, direction } = Astro.props;
const content = copy[page];
const info = presetInfo[preset];
const sections = content.variant === 'long' ? 6 : 0;
// Article pages are `work/<article>`; the article names its Shared elements.
const article = content.image && page.split('/')[1];
---

<Layout
  title={content.title}
  tint={content.tint}
  preset={preset}
  page={page}
  direction={direction}
  variant={content.variant}
  sharedTitle={article ? `${article}-title` : undefined}
>
  {
    content.image && (
      <img
        class="figure view-transition-shared-image"
        style={`--view-transition-shared-name: ${article}-image`}
        src={content.image}
        alt=""
        width="1600"
        height="1200"
      />
    )
  }

  <p class="lead">{content.body}</p>

  {
    page === 'work' && (
      <ul class="cards">
        {articles.map((article) => (
          <li>
            <a class="card" href={pageHref(preset, `work/${article}`, direction)}>
              <img
                class="view-transition-shared-image"
                style={`--view-transition-shared-name: ${article}-image`}
                src={copy[`work/${article}`].image}
                alt=""
                width="1600"
                height="1200"
              />
              <h2
                class="view-transition-shared"
                style={`--view-transition-shared-name: ${article}-title`}
              >
                {copy[`work/${article}`].title}
              </h2>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <dl class="facts">
    <div>
      <dt>Body class</dt>
      <dd class="mono">{presetClass(preset, direction)}</dd>
    </div>
    <div>
      <dt>Motion</dt>
      <dd>{info.motion}</dd>
    </div>
    <div>
      <dt>Page header</dt>
      <dd>{info.header}</dd>
    </div>
  </dl>

  <a class="action" href={pageHref(preset, content.next.href, direction)}>
    {content.next.label}
  </a>

  {
    Array.from({ length: sections }, (_, index) => (
      <section class="block">
        <h2>Section {index + 1}</h2>
        <p>{content.body}</p>
        <a class="action -secondary" href={pageHref(preset, content.next.href, direction)}>
          {content.next.label}
        </a>
      </section>
    ))
  }
</Layout>
