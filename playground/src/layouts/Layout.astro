---
import { existsSync } from 'node:fs';
import '../styles/playground.scss';
import Info from '../components/Info.astro';
import {
  directionLabel,
  directionsOf,
  families,
  pageHref,
  presetClass,
  presetInfo,
  presetLabel,
  presets,
  type PageId,
  type PresetId,
} from '../lib/routes';

interface Props {
  title: string;
  tint: string;
  preset: PresetId;
  page: PageId;
  direction?: string;
  variant?: 'long' | 'hero';
}

const { title, tint, preset, page, direction, variant } = Astro.props;
const bodyClass = [presetClass(preset, direction), variant && `-${variant}`]
  .filter(Boolean)
  .join(' ');

// GT Walsheim is licensed and not in the repo. Without the files the page uses
// the system font and does not request them.
const hasFonts = existsSync('public/fonts/GT-Walsheim-Medium.woff2');
const fontFaces = `
  @font-face { font-family: 'GT Walsheim'; font-weight: 500; font-display: swap;
    src: url('/fonts/GT-Walsheim-Medium.woff2') format('woff2'); }
  @font-face { font-family: 'GT Walsheim'; font-weight: 700; font-display: swap;
    src: url('/fonts/GT-Walsheim-Bold.woff2') format('woff2'); }`;

// Shapes for the cutout Preset, as the `url()` a site would point at its own SVG.
const svg = (viewBox: string, body: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='${viewBox}'>${body}</svg>`,
  )}")`;
const shapes = [
  { label: 'Circle', value: '' },
  {
    label: 'Gridonic mark',
    value: svg(
      '0 0 120 120',
      "<path d='M60.426 33.9563L53.2554 41.127L60.4503 48.3218L67.6209 41.1512L60.426 33.9563Z'/><path d='M60 0C26.8595 0 0 26.8595 0 60C0 93.1405 26.8595 120 60 120C93.1405 120 120 93.1405 120 60C120 26.8595 93.129 0 60 0ZM36.6692 57.716L31.9871 53.0339L36.6692 48.3517L41.3513 53.0339L36.6692 57.716ZM77.0156 88.6753L72.322 93.3689L60.4454 81.4922L48.6372 93.3003L43.9437 88.6068L55.7518 76.7986L43.8751 64.922L48.5687 60.2284L60.4454 72.1051L67.6399 64.9105L43.8637 41.1344L60.434 24.5641L77.027 41.1572L65.1618 53.0225L77.0384 64.8991L65.1504 76.7872L77.027 88.6639L77.0156 88.6753ZM84.1873 57.7274L79.5051 53.0453L84.1873 48.3631L88.8694 53.0453L84.1873 57.7274Z'/>",
    ),
  },
  {
    label: 'Star',
    value: svg(
      '0 0 24 24',
      "<path d='M12 1l3.1 7.3 7.9.7-6 5.2 1.8 7.8L12 17.9 5.2 22l1.8-7.8-6-5.2 7.9-.7z'/>",
    ),
  },
  {
    label: 'Diamond',
    value: svg('0 0 2 2', "<path d='M1 0l1 1-1 1-1-1z'/>"),
  },
];

// The page's own colours sit on `html`, where the transition can read them.
const foreground = variant === 'hero' ? '#faf9f7' : '#181716';

const nav = [
  { id: 'home' as const, label: 'Home' },
  { id: 'about' as const, label: 'About' },
  { id: 'work' as const, label: 'Work' },
  { id: 'long' as const, label: 'Long' },
  { id: 'hero' as const, label: 'Hero' },
];
---

<html lang="en" style={`--page-bg: ${tint}; --page-fg: ${foreground}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · page transitions</title>
    {hasFonts && <style is:inline set:html={fontFaces} />}
    <script is:inline>
      // Panel settings live in sessionStorage, keyed by the variable they set.
      // They reach the page as a stylesheet rule, the way a site would set
      // them: as inline styles on `html` they arrive a frame late in the
      // transition.
      const transitionVars = document.createElement('style');
      document.head.append(transitionVars);
      window.applyTransitionVars = () => {
        const declarations = Object.keys(sessionStorage)
          .filter((name) => name.startsWith('--view-transition-'))
          .map((name) => `${name}: ${sessionStorage.getItem(name)};`);
        transitionVars.textContent = `:root:root { ${declarations.join(' ')} }`;
      };
      window.applyTransitionVars();
      // The edge blur is a body class; add it before the page first renders.
      if (sessionStorage.getItem('--view-transition-edge-blur')) {
        new MutationObserver((_, observer) => {
          if (document.body) {
            document.body.classList.add('view-transition-edge-blur');
            observer.disconnect();
          }
        }).observe(document.documentElement, { childList: true });
      }
    </script>
  </head>
  <body class={bodyClass}>
    <header class="site-header view-transition-site-header">
      <div class="bar">
        <a class="brand" href={pageHref(preset, 'home', direction)}>
          <svg class="mark" viewBox="0 0 120 120" aria-hidden="true">
            <path
              fill="currentColor"
              d="M60.426 33.9563L53.2554 41.127L60.4503 48.3218L67.6209 41.1512L60.426 33.9563Z"
            ></path>
            <path
              fill="currentColor"
              d="M60 0C26.8595 0 0 26.8595 0 60C0 93.1405 26.8595 120 60 120C93.1405 120 120 93.1405 120 60C120 26.8595 93.129 0 60 0ZM36.6692 57.716L31.9871 53.0339L36.6692 48.3517L41.3513 53.0339L36.6692 57.716ZM77.0156 88.6753L72.322 93.3689L60.4454 81.4922L48.6372 93.3003L43.9437 88.6068L55.7518 76.7986L43.8751 64.922L48.5687 60.2284L60.4454 72.1051L67.6399 64.9105L43.8637 41.1344L60.434 24.5641L77.027 41.1572L65.1618 53.0225L77.0384 64.8991L65.1504 76.7872L77.027 88.6639L77.0156 88.6753ZM84.1873 57.7274L79.5051 53.0453L84.1873 48.3631L88.8694 53.0453L84.1873 57.7274Z"
            ></path>
          </svg>
          <span>Page transitions</span>
        </a>
        <nav class="pages" aria-label="Pages">
          {
            nav.map((item) => (
              <a
                href={pageHref(preset, item.id, direction)}
                aria-current={page === item.id ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <div class="page-header view-transition-header">
      <p class="eyebrow">{presetInfo[preset].family} · {presetLabel(preset)}</p>
      <h1>{title}</h1>
    </div>
    <main>
      <slot />
    </main>
    <details class="panel" data-panel open>
      <summary>Transition</summary>
      <div class="fields">
        <label>
          <span class="name">
            Preset
            <Info text="Which animation plays between two pages." />
          </span>
          <select data-navigate>
            {
              families.map((family) => (
                <optgroup label={family}>
                  {presets
                    .filter((item) => presetInfo[item].family === family)
                    .map((item) => (
                      <option
                        value={pageHref(item, page)}
                        selected={preset === item}
                      >
                        {presetLabel(item)}
                      </option>
                    ))}
                </optgroup>
              ))
            }
          </select>
        </label>
        {
          directionsOf(preset).length > 0 && (
            <label>
              <span class="name">
                Direction
                <Info text="The edge the incoming page, or the reveal, starts from." />
              </span>
              <select data-navigate>
                {directionsOf(preset).map((item) => (
                  <option
                    value={pageHref(preset, page, item)}
                    selected={direction === item}
                  >
                    {directionLabel(preset, item)}
                  </option>
                ))}
              </select>
            </label>
          )
        }
        {
          ['wipe', 'iris', 'split'].includes(preset) && (
            <label>
              <span class="name">
                Edge
                <Info text="How sharp the travelling edge is. A feathered edge fades over a distance and has no divider." />
              </span>
              <select data-var="--view-transition-feather">
                <option value="">Hard</option>
                <option value="12vmax">Feathered</option>
                <option value="40vmax">Very soft</option>
              </select>
            </label>
          )
        }
        {
          preset === 'cutout' && (
            <label>
              <span class="name">
                Shape
                <Info text="The SVG the new page shows through. It grows from the centre until it fills the screen." />
              </span>
              <select data-var="--view-transition-shape">
                {shapes.map((shape) => (
                  <option value={shape.value}>{shape.label}</option>
                ))}
              </select>
            </label>
          )
        }
        {
          preset === 'blur' && (
            <label>
              <span class="name">
                Blur
                <Info text="How strongly the pages are blurred as they leave and arrive." />
              </span>
              <select data-var="--view-transition-blur">
                <option value="8px">8px</option>
                <option value="">20px</option>
                <option value="40px">40px</option>
              </select>
            </label>
          )
        }
        {
          ['slide', 'cover', 'wipe', 'iris', 'split', 'cutout', 'lines'].includes(preset) && (
            <>
              <label>
                <span class="name">
                  Divider
                  <Info text="Thickness of a line drawn along the edge between the two pages." />
                </span>
                <span class="range">
                  <input
                    type="range"
                    min="0"
                    max="48"
                    value="0"
                    data-var="--view-transition-divider"
                    data-unit="px"
                  />
                  <output>0px</output>
                </span>
              </label>
              <label>
                <span class="name">
                  Line
                  <Info text="Colour of the divider, taken from the page being opened." />
                </span>
                <select data-var="--view-transition-divider-color">
                  <option value="">Text colour</option>
                  <option value="var(--page-bg)">Background colour</option>
                  <option value="var(--color-primary)">Accent colour</option>
                </select>
              </label>
            </>
          )
        }
        {
          ['slide', 'cover', 'wipe', 'iris'].includes(preset) && (
            <label>
              <span class="name">
                Edge blur
                <Info text="Blurs both pages where they meet, strongest on the seam itself." />
              </span>
              <select data-var="--view-transition-edge-blur" data-edge-blur>
                <option value="">Off</option>
                <option value="4px">Light</option>
                <option value="8px">Medium</option>
                <option value="16px">Strong</option>
              </select>
            </label>
          )
        }
        <label>
          <span class="name">
            Easing
            <Info text="How the motion speeds up and slows down. Preset default keeps the curves each Preset ships with." />
          </span>
          <select data-var="--view-transition-ease">
            <option value="">Preset default</option>
            <option value="linear">Linear</option>
            <option value="cubic-bezier(0.65, 0, 0.35, 1)">Cubic in-out</option>
            <option value="cubic-bezier(0.75, 0, 0.25, 1)">Quart in-out</option>
            <option value="cubic-bezier(0.83, 0, 0.17, 1)">Quint in-out</option>
            <option value="cubic-bezier(0.85, 0, 0.15, 1)">Circ in-out</option>
            <option value="cubic-bezier(0.33, 1, 0.68, 1)">Cubic out</option>
            <option value="cubic-bezier(0.16, 1, 0.3, 1)">Expo out</option>
            <option value="linear(0, 0.36 14%, 0.86 28%, 1.08 38%, 1.1 46%, 1.02 62%, 0.99 76%, 1)">
              Spring, overshoot
            </option>
          </select>
        </label>
        <label>
          <span class="name">
            Duration
            <Info text="The base length. Each Preset runs for a fixed multiple of it." />
          </span>
          <select data-var="--view-transition-duration">
            <option value="0.3s">0.3s</option>
            <option value="">0.6s</option>
            <option value="1s">1s</option>
            <option value="2s">2s</option>
            <option value="5s">5s</option>
          </select>
        </label>
      </div>
    </details>
    <script is:inline>
      const panel = document.querySelector('[data-panel]');
      // Starts collapsed on narrow screens, where it would cover the page.
      panel.open = sessionStorage.getItem('panel')
        ? sessionStorage.getItem('panel') === 'open'
        : matchMedia('(min-width: 48rem)').matches;
      panel.addEventListener('toggle', () => {
        sessionStorage.setItem('panel', panel.open ? 'open' : 'closed');
      });
      // An empty value, or a slider at its start, is the package default: the
      // variable is left unset.
      document.querySelectorAll('[data-var]').forEach((field) => {
        const name = field.dataset.var;
        const unit = field.dataset.unit ?? '';
        const output = field.parentElement.querySelector('output');
        const stored = sessionStorage.getItem(name);
        field.value = stored ? (unit ? parseFloat(stored) : stored) : field.defaultValue ?? '';
        const show = () => {
          if (output) output.textContent = field.value + unit;
        };
        show();
        field.addEventListener('input', () => {
          show();
          if (field.value && field.value !== field.min) {
            sessionStorage.setItem(name, field.value + unit);
          } else {
            sessionStorage.removeItem(name);
          }
          window.applyTransitionVars();
        });
      });
      // A feathered edge has no divider, so its controls go quiet.
      const feather = document.querySelector(
        '[data-var="--view-transition-feather"]',
      );
      if (feather) {
        const sync = () => {
          document
            .querySelectorAll('[data-var^="--view-transition-divider"]')
            .forEach((field) => {
              field.disabled = feather.value !== '';
            });
        };
        feather.addEventListener('input', sync);
        sync();
      }
      const edgeBlur = document.querySelector('[data-edge-blur]');
      if (edgeBlur) {
        edgeBlur.addEventListener('input', () => {
          document.body.classList.toggle(
            'view-transition-edge-blur',
            edgeBlur.value !== '',
          );
        });
      }
      document.querySelectorAll('[data-navigate]').forEach((select) => {
        select.addEventListener('change', () => {
          location.href = select.value;
        });
      });
    </script>
  </body>
</html>
